{
  "name": "blue-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "dev": "expo start --dev-client",
    "android:build": "pnpm android:branding && expo run:android --variant debug --no-bundler",
    "android:smoke": "node scripts/android-smoke.mjs",
    "test:native:case": "node scripts/run-case.mjs",
    "capture:case": "node scripts/capture-case.mjs",
    "test:visual:case": "node scripts/check-visual.mjs",
    "test:layout:case": "node scripts/check-layout.mjs",
    "test:a11y:case": "node scripts/check-a11y.mjs",
    "android:branding": "node scripts/sync-android-branding.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "5.105.0",
    "expo": "57.0.31",
    "expo-camera": "57.0.6",
    "expo-dev-client": "57.0.20",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "57.0.13",
    "expo-location": "~57.0.22",
    "expo-media-library": "57.0.5",
    "expo-network": "~57.0.3",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "js-sha256": "1.0.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-hook-form": "7.91.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.5",
    "@react-native/jest-preset": "0.86.3",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "prettier": "3.9.10",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
